<?xml version="1.0" encoding="utf-8"?>
<!-- 调度按钮状态：selected = 实色填充；未选中 = 浅底 + 描边（不用 alpha，浅色主题下才看得见） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/scene_pw_performance_on_container" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scene_pw_performance_off_container" />
            <stroke android:width="1dp" android:color="@color/scene_pw_performance_off_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>