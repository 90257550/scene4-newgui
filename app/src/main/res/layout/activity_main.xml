<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:keepScreenOn="false">

    <!-- 内容区：顶部避开 Toolbar，底部避开底部导航 -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tab_list"
        android:layout_marginTop="?actionBarSize" />

    <!-- 底部导航（原顶部 TabLayout）
         背景与选中色都用 M3 语义色：Android 12+ 跟随壁纸动态取色，
         低版本回退到 AppTheme 里定义的静态色板 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/tab_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurface"
        app:elevation="3dp"
        app:itemActiveIndicatorStyle="@style/SceneNavIndicator"
        app:itemIconTint="@color/scene_nav_item"
        app:itemTextColor="@color/scene_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

    <include
        layout="@layout/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
