<?xml version="1.0" encoding="utf-8"?>
<!-- 新首页仪表盘（里程碑1 / 方案B：重构式）
     要点：
     1. 全部 id 与原 fragment_home.xml 保持一致（32 个），FragmentHome.kt 的 synthetic 绑定无需改动
     2. 卡片容器改为 MaterialCardView（圆角 12dp）
     3. 颜色全部引用 M3 语义色（colorSurface / colorOnSurface 等），
        Android 12+ 由壁纸动态取色，低版本回退到 AppTheme 的静态色板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp">

    <!-- 滚动区：layout_weight=1 撑满剩余高度，内容不足一屏时也不会把操作栏顶上去。
         scrollbars=none + overScrollMode 保持原有的无滚动条观感 -->
    <com.omarea.common.ui.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_mainview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_clear_ram"
                    style="@style/SceneCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <TextView
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="RAM" />

                            <com.omarea.ui.RamChartView
                                android:id="@+id/home_raminfo"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:free="1"
                                app:total="1" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SceneCardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="物理内存" />

                            <TextView
                                android:id="@+id/home_raminfo_text"
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_clear_swap"
                    style="@style/SceneCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SceneCardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="交换分区" />

                            <TextView
                                android:id="@+id/home_zramsize_text"
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="2dp"
                                android:text="0% (0MB)" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <TextView
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="SWAP" />

                            <com.omarea.ui.RamChartView
                                android:id="@+id/home_swapstate_chat"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:free="1"
                                app:total="1" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/SceneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/textSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SwapCached " />

                    <TextView
                        android:id="@+id/home_swap_cached"
                        style="@style/textSmallTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/textSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buffers " />

                    <TextView
                        android:id="@+id/home_buffers"
                        style="@style/textSmallTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/textSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dirty " />

                    <TextView
                        android:id="@+id/home_dirty"
                        style="@style/textSmallTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/home_gpuview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/SceneCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <com.omarea.ui.CpuChartView
                                android:id="@+id/home_gpu_chat"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:free="0"
                                app:total="100" />

                            <TextView
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="GPU" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/home_gpu_freq"
                                style="@style/SceneStatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="- Mhz" />

                            <TextView
                                android:id="@+id/home_gpu_load"
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="- %" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/SceneCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cpu_core_count"
                                style="@style/SceneCardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="核心数" />

                            <TextView
                                android:id="@+id/cpu_core_total_load"
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="2dp"
                                android:text="- %" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <com.omarea.ui.CpuChartView
                                android:id="@+id/home_cpu_chat"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:free="0"
                                app:total="100" />

                            <TextView
                                style="@style/SceneStatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="CPU" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/SceneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- 每核频率网格：沿用原 OverScrollGridView（4 列 + 固定高度），
                     代码通过 adapter + setOnItemClickListener 填充 -->
                <com.omarea.common.ui.OverScrollGridView
                    android:id="@+id/cpu_core_list"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="4"
                    android:padding="4dp"
                    android:scrollbars="none" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/SceneCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_power_supply"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_battery_now"
                                style="@style/SceneStatValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="- mA"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/home_battery_edit"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:padding="2dp"
                                android:src="@drawable/edit"
                                app:tint="?android:attr/colorAccent" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_capacity"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_battery_capacity"
                                style="@style/SceneStatLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="- %" />

                            <ImageView
                                android:id="@+id/home_battery_settings"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:padding="2dp"
                                android:src="@drawable/ic_settings"
                                app:tint="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_temperature"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_battery_temperature"
                                style="@style/SceneStatLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="- C" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/SceneCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/icon_android"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_device_name"
                                style="@style/SceneStatValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Andorid"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_clock"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_running_time"
                                style="@style/SceneStatLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="0s" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_help"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/icon_global"
                                app:tint="?android:attr/colorAccent" />

                            <TextView
                                style="@style/SceneStatLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="访问Scene官网" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/home_message"
                style="@style/SceneStatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </com.omarea.common.ui.OverScrollView>

    <!-- 四档调度操作栏：作为独立底部操作区，用 M3 surface 承载，
         与上方滚动内容形成明确分区（原实现是裸按钮直接浮在页面底色上） -->
    <LinearLayout
        android:id="@+id/powermode_toggles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_powersave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/scene_btn_powersave"
            app:backgroundTint="@null"
            android:text="@string/powersave_short"
            android:textColor="@color/scene_pw_powersave_off_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_defaultmode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/scene_btn_balance"
            app:backgroundTint="@null"
            android:text="@string/balance_short"
            android:textColor="@color/scene_pw_balance_off_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_gamemode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/scene_btn_performance"
            app:backgroundTint="@null"
            android:text="@string/performance_short"
            android:textColor="@color/scene_pw_performance_off_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_fastmode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/scene_btn_fast"
            app:backgroundTint="@null"
            android:text="@string/fast_short"
            android:textColor="@color/scene_pw_fast_off_text"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
